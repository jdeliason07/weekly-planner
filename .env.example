# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (server-only, used by /api/ask) ---
ANTHROPIC_API_KEY=

# --- Google OAuth (configured in Supabase Auth -> Providers -> Google) ---
# These are set in the Supabase dashboard, not here. See SETUP.md.
# The client id/secret below are only needed if you refresh provider tokens
# yourself in a route handler (recommended — see lib/google/tokens.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to "1" to run the UI with in-memory seed data and no Supabase/Google.
# Lets you review the design system and planning grid without any accounts.
NEXT_PUBLIC_DEMO_MODE=1
